# Copie para ".env" e ajuste. Sem MongoDB/Redis a aplicação sobe em modo
# degradado (login com ADMIN_USER/ADMIN_PASSWORD; dashboard/listas vazios).

# ----- Aplicação web --------------------------------------------------------
SECRET_KEY=troque-esta-chave-em-producao
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
UPLOAD_MAX_MB=50
RAW_DIR=data/raw
UPLOAD_DIR=data/uploads

# ----- Modelo ----------------------------------------------------------------
MODEL_PATH=modelos/churn_model.joblib
MODEL_META_PATH=modelos/churn_model.meta.json

# ----- Faixas de risco padrão (editáveis depois em Admin > Config) ----------
LIMIAR_ALTO=0.50
LIMIAR_MEDIO=0.30

# ----- MongoDB (local: docker compose up -d ; Atlas: cole a connection string)
# MONGO_MOCK=true usa um banco EM MEMÓRIA (mongomock) em vez de um MongoDB real —
# sem servidor, sem Docker, sem rede. Útil para testar em máquina institucional
# sem Docker (ver README). Requer "pip install -r requirements-dev.txt".
MONGO_MOCK=true
MONGO_URI=mongodb://localhost:27017
MONGO_DB=gestao_academia
MONGO_TLS=auto
MONGO_TIMEOUT_MS=8000
MONGO_BATCH=5000

# ----- Redis (cache; opcional) ----------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=2592000

# ----- API interna (routes/api_routes.py) -----------------------------------
API_TOKEN=
ALTO_RISCO_LIMIT=100
